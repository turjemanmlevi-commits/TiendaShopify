{% doc %}
  Renders a native Shopify product card with approved imagery and actual prices.
  @param {product} product - The Shopify product to display.
{% enddoc %}
<article class="ht-card" data-ht-reveal>
  <a class="ht-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {% render 'ht-product-image', product: product %}
    <span class="ht-card__arrow" aria-hidden="true">↗</span>
    {%- unless product.available -%}<span class="ht-card__status">{{ 'ht.product.unavailable' | t }}</span>{%- endunless -%}
  </a>
  <div class="ht-card__details">
    <p class="ht-eyebrow">{{ 'ht.product.category' | t }}</p>
    <h3><a href="{{ product.url }}">{{ product.title | split: ' — ' | first | escape }}</a></h3>
    <p class="ht-card__price">{% if product.price_varies %}{{ 'ht.product.from' | t }} {% endif %}{{ product.price | money_with_currency }}</p>
  </div>
</article>
