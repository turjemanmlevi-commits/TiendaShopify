<div class="ht-shell ht-review-wrap">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {% render 'ht-product-reviews', product: product %}
  {%- endif -%}
</div>
{% schema %}
{"name":"Product reviews","settings":[],"blocks":[{"type":"@app"}],"presets":[{"name":"Product reviews"}]}
{% endschema %}
