<section class="ht-shell ht-search ht-section"><div class="ht-section-heading ht-centered">{% render 'ht-bow' %}<p class="ht-eyebrow">{{ 'ht.search.eyebrow' | t }}</p><h1>{{ 'ht.search.heading' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="ht-search-form"><label class="visually-hidden" for="ht-search-input">{{ 'general.search.search' | t }}</label><input id="ht-search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'ht.search.placeholder' | t }}" required><input type="hidden" name="type" value="product"><button class="ht-button" type="submit">{{ 'general.search.search' | t }}</button></form></div>
  {% if search.performed %}{% paginate search.results by 24 %}<p class="ht-results-count" role="status">{{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}</p><div class="ht-product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'ht-product-card', product: item %}{% else %}<article class="ht-search-text"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncatewords: 25 }}</p></article>{% endif %}{% else %}<div class="ht-empty"><h2>{{ 'ht.search.empty' | t }}</h2><p>{{ 'ht.search.try' | t }}</p><a class="ht-button" href="{{ routes.all_products_collection_url }}">{{ 'ht.nav.all' | t }}</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% else %}<div class="ht-search-suggestions"><a class="ht-text-link" href="{{ routes.search_url }}?type=product&amp;q=ghost">{{ 'ht.home.ghosts' | t }} ↗</a><a class="ht-text-link" href="{{ routes.search_url }}?type=product&amp;q=pumpkin">{{ 'ht.home.pumpkins' | t }} ↗</a><a class="ht-text-link" href="{{ routes.all_products_collection_url }}">{{ 'ht.nav.all' | t }} ↗</a></div>{% endif %}
</section>
{% schema %}
{"name":"Haunted Tips search","settings":[]}
{% endschema %}
