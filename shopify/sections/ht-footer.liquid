<footer class="ht-footer"><div class="ht-shell">
  <div class="ht-footer__top"><div class="ht-footer__brand"><a href="{{ routes.root_url }}">{% render 'ht-bow' %}<span>{{ settings.ht_brand_name | escape }}</span></a><p>{{ 'ht.footer.intro' | t }}</p><span class="ht-eyebrow">{{ 'ht.brand.tagline' | t }}</span></div>
  <nav aria-label="{{ 'ht.footer.shop' | t }}"><h2>{{ 'ht.footer.shop' | t }}</h2><a href="{{ routes.all_products_collection_url }}">{{ 'ht.nav.all' | t }}</a><a href="{{ routes.root_url }}pages/our-story">{{ 'ht.nav.story' | t }}</a><a href="{{ routes.root_url }}pages/nail-guide">{{ 'ht.nav.guide' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a></nav>
  <nav aria-label="{{ 'ht.footer.help' | t }}"><h2>{{ 'ht.footer.help' | t }}</h2><a href="{{ routes.root_url }}pages/faqs">{{ 'ht.nav.help' | t }}</a><a href="{{ routes.root_url }}pages/contact">{{ 'ht.nav.contact' | t }}</a>{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">{{ 'ht.footer.shipping' | t }}</a>{% endif %}{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'ht.footer.returns' | t }}</a>{% endif %}{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>{% endif %}</nav>
  <div class="ht-footer__contact"><h2>{{ 'ht.footer.note' | t }}</h2><p>{{ 'ht.footer.contact_copy' | t }}</p>{% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>{% endif %}<a class="ht-text-link" href="{{ routes.root_url }}pages/contact">{{ 'ht.footer.write' | t }} <span aria-hidden="true">↗</span></a></div></div>
  <div class="ht-footer__bottom"><span>© {{ 'now' | date: '%Y' }} {{ settings.ht_brand_name | escape }}</span><div>{% if shop.privacy_policy.body != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'ht.footer.privacy' | t }}</a>{% endif %}{% if shop.terms_of_service.body != blank %}<a href="{{ shop.terms_of_service.url }}">{{ 'ht.footer.terms' | t }}</a>{% endif %}{% if shop.legal_notice.body != blank %}<a href="{{ shop.legal_notice.url }}">{{ 'ht.footer.legal' | t }}</a>{% endif %}<span>{{ 'ht.footer.currency' | t: currency: cart.currency.iso_code }}</span></div></div>
</div></footer>
{% schema %}
{"name":"Haunted Tips footer","settings":[{"type":"text","id":"contact_email","label":"Contact email","default":"turjemanmlevi@gmail.com"}]}
{% endschema %}
