{%- liquid
  assign edit = section.settings.collection
  if edit == blank
    assign edit = collections.all
  endif
  assign edit_url = edit.url | default: routes.all_products_collection_url
-%}
<section class="ht-hero" aria-labelledby="ht-hero-heading">
  <img class="ht-hero__photo" src="{{ 'ht-editorial-night-crawlers.webp' | asset_url }}" alt="{{ 'ht.images.hero' | t }}" width="1254" height="1254" loading="eager" fetchpriority="high">
  <div class="ht-hero__shade"></div>
  <div class="ht-charms" aria-hidden="true"><span>✧</span><span>☾</span><span>✦</span></div>
  <div class="ht-shell ht-hero__inner">
    <div class="ht-hero__copy">
      <h1 id="ht-hero-heading">{{ section.settings.heading | escape }}<br><em>{{ section.settings.heading_emphasis | escape }}</em></h1>
      <p class="ht-hero__intro">{{ section.settings.intro | escape }}</p>
      <a class="ht-button ht-button--blush" href="{{ edit_url }}">{{ 'ht.home.shop' | t }} <span aria-hidden="true">↗</span></a>
      <a class="ht-hero__story" href="{{ routes.root_url }}pages/our-story">{{ 'ht.home.enter' | t }} <span aria-hidden="true">→</span></a>
      {% render 'ht-bow' %}
    </div>
    <a class="ht-hero__scroll" href="#ht-the-edit"><span aria-hidden="true">↓</span> {{ 'ht.home.fall' | t }}</a>
    <span class="ht-hero__aside">{{ 'ht.brand.tagline' | t }}</span>
  </div>
</section>
<div class="ht-ribbon">
  <div class="ht-ribbon__window"><div class="ht-ribbon__track">
    {%- for repeat in (1..2) -%}<div class="ht-ribbon__group"{% if repeat == 2 %} aria-hidden="true"{% endif %}><span>{{ 'ht.home.ribbon_one' | t }}</span><i aria-hidden="true">✧</i><span>{{ 'ht.home.ribbon_two' | t }}</span><i aria-hidden="true">✧</i><span>{{ 'ht.home.ribbon_three' | t }}</span><i aria-hidden="true">✧</i><span>{{ 'ht.home.ribbon_four' | t }}</span><i aria-hidden="true">✧</i></div>{%- endfor -%}
  </div></div>
  <button class="ht-motion-toggle" type="button" data-ht-motion aria-pressed="false" aria-label="{{ 'ht.motion.pause' | t }}" data-pause="{{ 'ht.motion.pause' | t }}" data-play="{{ 'ht.motion.play' | t }}" hidden><span aria-hidden="true">Ⅱ</span></button>
</div>
<section class="ht-shell ht-section" id="ht-the-edit" aria-labelledby="ht-edit-heading">
  <div class="ht-section-heading" data-ht-reveal><div><p class="ht-eyebrow">{{ 'ht.home.obsession' | t }}</p><h2 id="ht-edit-heading">{{ 'ht.home.love' | t }} <em>{{ 'ht.home.fright' | t }}</em></h2></div><a class="ht-text-link" href="{{ edit_url }}">{{ 'ht.nav.all' | t }} <span aria-hidden="true">↗</span></a></div>
  <div class="ht-product-grid">
    {%- for product in edit.products limit: section.settings.product_limit -%}{% render 'ht-product-card', product: product %}{%- else -%}<div class="ht-empty">{% render 'ht-bow' %}<h3>{{ 'ht.home.empty_heading' | t }}</h3><p>{{ 'ht.home.empty_copy' | t }}</p><a class="ht-text-link" href="{{ routes.root_url }}pages/contact">{{ 'ht.nav.contact' | t }}</a></div>{%- endfor -%}
  </div>
  <p class="ht-footnote"><span aria-hidden="true">✧</span> {{ 'ht.home.manicure' | t }} <span aria-hidden="true">✧</span></p>
</section>
<section class="ht-moods ht-section" aria-labelledby="ht-moods-heading"><div class="ht-shell">
  <div class="ht-section-heading ht-centered" data-ht-reveal>{% render 'ht-bow' %}<p class="ht-eyebrow">{{ 'ht.home.details' | t }}</p><h2 id="ht-moods-heading">{{ 'ht.home.pretty' | t }} <em>{{ 'ht.home.personality' | t }}</em></h2><p>{{ 'ht.home.follow' | t }}</p></div>
  <div class="ht-mood-grid">
    <a class="ht-mood ht-mood--romance" href="{{ routes.search_url }}?type=product&amp;q=black" data-ht-reveal><div class="ht-mood__photo"><img src="{{ 'ht-editorial-noir-halo.webp' | asset_url }}" alt="Noir Halo black almond nails with silver-toned stud borders on burgundy satin; AI-styled product photograph" width="1254" height="1254" loading="lazy"></div><span class="ht-mood__tag">{{ 'ht.home.romance' | t }} <span aria-hidden="true">↗</span></span><div class="ht-mood__copy"><h3>{{ 'ht.home.sweetheart' | t }} <em>{{ 'ht.home.dark_soul' | t }}</em></h3><p>{{ 'ht.home.romance_copy' | t }}</p><span class="ht-text-link">{{ 'ht.home.black' | t }} →</span></div></a>
    <a class="ht-mood ht-mood--frights" href="{{ routes.search_url }}?type=product&amp;q=ghost" data-ht-reveal><div class="ht-mood__photo"><img src="{{ 'ht-editorial-pastel-pumpkin-party.webp' | asset_url }}" alt="Pastel Pumpkin Party pink and lilac square nails with a friendly spider, ghost, pumpkin, webs and BOO details; AI-styled product photograph" width="1254" height="1254" loading="lazy"></div><span class="ht-mood__tag">{{ 'ht.home.frights' | t }} <span aria-hidden="true">↗</span></span><div class="ht-mood__copy"><h3>{{ 'ht.home.scary' | t }} <em>{{ 'ht.home.cute' | t }}</em></h3><p>{{ 'ht.home.frights_copy' | t }}</p><span class="ht-text-link">{{ 'ht.home.ghosts' | t }} →</span></div></a>
    <a class="ht-mood ht-mood--pumpkin" href="{{ routes.search_url }}?type=product&amp;q=pumpkin" data-ht-reveal><div class="ht-mood__photo"><img src="{{ 'ht-editorial-copper-coven.webp' | asset_url }}" alt="Copper Coven long black and orange nails with yellow pumpkins, drips, spiders, webs and bats; AI-styled product photograph" width="1254" height="1254" loading="lazy"></div><span class="ht-mood__tag">{{ 'ht.home.after_dark' | t }} <span aria-hidden="true">↗</span></span><div class="ht-mood__copy"><h3>{{ 'ht.home.midnight' | t }} <em>{{ 'ht.home.muse' | t }}</em></h3><p>{{ 'ht.home.after_copy' | t }}</p><span class="ht-text-link">{{ 'ht.home.pumpkins' | t }} →</span></div></a>
  </div>
</div></section>
<section class="ht-shell ht-section ht-story">
  <div class="ht-story__photo" data-ht-reveal><img src="{{ 'ht-editorial-pumpkin-web-french.webp' | asset_url }}" alt="Pumpkin Web French long nude square nails with orange jack-o-lanterns, black webs, spiders and flame accents; AI-styled product photograph" width="1254" height="1254" loading="lazy"></div>
  <div class="ht-story__copy" data-ht-reveal><p class="ht-eyebrow">{{ 'ht.home.world' | t }}</p><h2>{{ 'ht.home.because' | t }}<br>{{ 'ht.home.should' | t }} <em>{{ 'ht.home.dark_side' | t }}</em></h2><p>{{ 'ht.home.story_one' | t }}</p><p>{{ 'ht.home.story_two' | t }}</p><a class="ht-text-link" href="{{ routes.root_url }}pages/our-story">{{ 'ht.home.about' | t }} <span aria-hidden="true">↗</span></a></div>
</section>
<section class="ht-guide-teaser"><div class="ht-shell ht-guide-teaser__layout"><div class="ht-guide-teaser__photo"><img src="{{ 'ht-editorial-pumpkin-peek.webp' | asset_url }}" alt="Pumpkin Peek pink square nails with black cat tips, orange pumpkins, white ghosts and spider accents; AI-styled product photograph" width="1254" height="1254" loading="lazy"></div><div class="ht-guide-teaser__copy"><span class="ht-eyebrow">{{ 'ht.home.little_ritual' | t }}</span><h2>{{ 'ht.home.new' | t }} <em>{{ 'ht.home.press_ons' | t }}</em></h2><p>{{ 'ht.home.guide_copy' | t }}</p><a class="ht-button" href="{{ routes.root_url }}pages/nail-guide">{{ 'ht.home.guide_link' | t }} <span aria-hidden="true">↗</span></a></div></div></section>
{% schema %}
{"name":"Haunted Tips home","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Press-ons from the dark side"},{"type":"text","id":"heading","label":"Heading","default":"Wicked nails."},{"type":"text","id":"heading_emphasis","label":"Accent heading","default":"Sweet screams."},{"type":"textarea","id":"intro","label":"Introduction","default":"For the sweet ones, the strange ones, and the beautifully both. Halloween nails with a personality all their own."},{"type":"collection","id":"collection","label":"Featured nail collection"},{"type":"range","id":"product_limit","label":"Products to show","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"Haunted Tips home"}]}
{% endschema %}
